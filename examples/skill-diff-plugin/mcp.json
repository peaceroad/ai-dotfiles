{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "skill-diff": {
      "type": "stdio",
      "command": "python3",
      "args": ["-B", "${PLUGIN_ROOT}/skills/compare-skill-snapshots/scripts/server.py"],
      "env": {
        "SKILL_DIFF_ROOT": "${PLUGIN_DATA}/snapshots"
      },
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}

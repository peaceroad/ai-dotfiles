{
  "schema": 1,
  "mode": "improve",
  "goal": "Update this fictional retention skill to the new policy: records become eligible at 30 days instead of 7. Preserve legal-hold precedence and the deletion-approval requirement. Implement the general policy, not per-example exceptions. Classification only; never perform deletion.",
  "target": {
    "root": "./fixtures/retention-current",
    "files": [
      "SKILL.md"
    ]
  },

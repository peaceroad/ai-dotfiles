{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plugin-creator-agent-plugins:marketplace-development-schema:v1",
  "$comment": "@plugin-creator-agent-plugins managed-marketplace-schema v1",
  "title": "Agent Plugin Marketplace Development Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "displayName",
    "plugins"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "category"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path or a path relative to the Marketplace root."
        },
        "category": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "name": "ai-dotfiles",
  "private": true,
  "type": "module",
  "description": "Shareable Codex and AI agent configuration files.",
  "scripts": {
    "check": "node --test export.test.mjs && node export.js --dry-run && npm run check:agent-dev && npm run check:skill-links && npm run check:plugin-tools && npm run check:plugins",
    "check:agent-dev": "npm run check:agent-dev:common && node --input-type=module -e \"if (process.platform === 'win32') { const { spawnSync } = await import('node:child_process'); const r = spawnSync('pwsh', ['-NoProfile', '-File', 'scripts/test-install-agent.ps1'], { stdio: 'inherit' }); process.exit(r.status ?? 1); }\"",
    "check:plugins": "node plugins/agent-plugin-tools/skills/plugin-creator-agent-plugins/scripts/validate-agent-plugin.mjs plugins/agent-design-tools && node plugins/agent-plugin-tools/skills/plugin-creator-agent-plugins/scripts/validate-agent-plugin.mjs plugins/agent-plugin-tools",
    "check:skill-links": "node --test tools/agent/manage-skill-links.test.mjs && node home/.agents/ai-dotfiles/runtime/manage-skill-links.mjs validate",
    "check:plugin-tools": "node plugins/agent-plugin-tools/skills/plugin-creator-agent-plugins/scripts/validate-agent-plugin.test.mjs && node plugins/agent-plugin-tools/skills/plugin-creator-agent-plugins/scripts/manage-local-agent-plugin.test.mjs && node --test plugins/agent-plugin-tools/skills/plugin-creator-agent-plugins/scripts/scaffold-local-agent-plugin.test.mjs plugins/agent-plugin-tools/skills/plugin-creator-agent-plugins/scripts/assemble-agent-marketplace.test.mjs && node plugins/agent-plugin-tools/skills/plugin-creator-agent-plugins/scripts/check-builtin-plugin-creator.test.mjs",
    "build": "node export.js --write",
    "skill-links:status": "node home/.agents/ai-dotfiles/runtime/manage-skill-links.mjs status",
    "skill-links:check": "node home/.agents/ai-dotfiles/runtime/manage-skill-links.mjs check",
    "skill-links:sync": "node home/.agents/ai-dotfiles/runtime/manage-skill-links.mjs sync",
    "check:agent-dev:common": "node --test tools/agent/agent.test.mjs scripts/install-agent.test.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
